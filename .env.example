APP_NAME=LeadCob AI
APP_ENV=development
SECRET_KEY=troque-esta-chave-antes-de-publicar
DATABASE_URL=postgresql+psycopg://leadcob:leadcob_dev@db:5432/leadcob
REDIS_URL=redis://redis:6379/0
# Exemplos fictícios só para demonstração (nunca em uso real)
DEMO_SEED=false

PNCP_API_BASE=https://pncp.gov.br/api/consulta
PNCP_SITE=https://pncp.gov.br

# Dados abertos CNPJ (compartilhamento público da Receita). Espelho com os mesmos arquivos:
# Informe a referência pública atual do compartilhamento da Receita quando necessário.
RFB_SHARE_TOKEN=
RFB_CNPJ_DIR=Dados/Cadastros/CNPJ

# Vagas: boards Greenhouse/Lever além de config/job_boards.json (formato da v0.3)
# JOB_BOARD_SOURCES_JSON=[{"provider":"greenhouse","token":"empresa","company_name":"Empresa","cnpj":"00000000000000"}]
JOB_BOARD_SOURCES_JSON=

# DataJud (CNJ): chave PÚBLICA publicada em https://datajud-wiki.cnj.jus.br/api-publica/acesso (pode mudar).
# Obtenha a chave pública atual no endereço acima; vazia desativa a consulta.
DATAJUD_API_KEY=

# Online: APP_ENV=production, PUBLIC_URL=https://seu-dominio.com e uma senha
# Gere ADMIN_PASSWORD_HASH com: PYTHONPATH=backend python -m app.core.security
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
PUBLIC_URL=

# Assistente desativado até configurar todos os valores abaixo. Preços USD / 1 milhão
# de tokens devem corresponder ao modelo escolhido (consulte tabela oficial atual).
OPENAI_API_KEY=
OPENAI_MODEL=
ASSISTANT_MONTHLY_BUDGET_USD=0
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
BRAVE_SEARCH_API_KEY=
# docker compose -f docker-compose.cloud.yml requer domínio e senha PostgreSQL
DOMAIN=
POSTGRES_PASSWORD=
